/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
	int test=0;
	divisore = 0;


  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();
  MX_TIM1_Init();
  MX_TIM7_Init();
  MX_SPI1_Init();
  MX_I2C1_Init();
  /* USER CODE BEGIN 2 */

  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
  __HAL_TIM_MOE_ENABLE(&htim1);
  // Azzera preventivamente i buffer di ricezione
  memset(uart1_rx_buffer, 0, BUFFER_SIZE);
  memset(uart2_rx_buffer, 0, BUFFER_SIZE);
  memset(msg, 0, BUFFER_SIZE);

  // Attiva la ricezione del primo byte ad interrupt su entrambe le porte
  HAL_UART_Receive_IT(&huart1, &uart1_tmp_byte, 1);
  HAL_UART_Receive_IT(&huart2, &uart2_tmp_byte, 1);

  temporizzatore = false;
  read_SDP810 = false;
  HAL_TIM_Base_Start_IT(&htim7);
  CS_High();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */


  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

    // 1. Se UART1 ha accumulato una stringa intera, la spedisce a UART2
    if (uart1_str_ready)
    {
      // Trasmissione bloccante della stringa intera accumulata
      HAL_UART_Transmit(&huart2, (uint8_t*)uart1_rx_buffer, strlen(uart1_rx_buffer), 200);

      // OPZIONALE: Se vuoi forzare l'invio a capo anche sulla destinazione rimuovi il commento sotto:
      // HAL_UART_Transmit(&huart2, (uint8_t*)"\r\n", 2, 10);

      /* Reset del buffer e ripristino delle condizioni di ascolto */
      parser();
      __disable_irq(); // Protezione da corruzioni se arriva un byte durante il reset
      memset(uart1_rx_buffer, 0, BUFFER_SIZE);
      uart1_idx = 0;
      uart1_str_ready = false;
      __enable_irq();
    }

    // 2. Se UART2 ha accumulato una stringa intera, la spedisce a UART1
    if (uart2_str_ready)
    {
      // Trasmissione bloccante della stringa intera accumulata
      HAL_UART_Transmit(&huart1, (uint8_t*)uart2_rx_buffer, strlen(uart2_rx_buffer), 200);

      // OPZIONALE: Se vuoi forzare l'invio a capo anche sulla destinazione rimuovi il commento sotto:
      // HAL_UART_Transmit(&huart1, (uint8_t*)"\r\n", 2, 10);

      /* Reset del buffer e ripristino delle condizioni di ascolto */
      __disable_irq(); // Protezione da corruzioni
      memset(uart2_rx_buffer, 0, BUFFER_SIZE);
      uart2_idx = 0;
      uart2_str_ready = false;
      __enable_irq();
    }


    // +-----------------------FINE PARTE MESSAGGI--------------------+


    if(temporizzatore){ //CODICE TEMPORIZZATO (1000Hz)
    	temporizzatore=false;
    	if(test%1000==0){
    		snprintf(msg,BUFFER_SIZE,"Tempo %d \n\r",test/1000);
        	HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), 200);
    	}
    	test++;
    }

    if(temporizzatore_PID){
    	temporizzatore_PID=false;
    	if(read_SDP810){
    		SDP810_Read();
    	}
    }


  }
  /* USER CODE END 3 */
}


/* ── Helper: CS ────────────────────────────────────────────────── */
static inline void CS_Low(void)  { HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_RESET); }
static inline void CS_High(void) { HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, GPIO_PIN_SET);   }

/* ── Helper: attendi fine scrittura (polling WIP bit) ───────────── */
static void EEPROM_WaitReady(void)
{
    uint8_t cmd = EEPROM_RDSR;
    uint8_t status;
    do {
        CS_Low();
        HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
        HAL_SPI_Receive (&hspi1, &status, 1, HAL_MAX_DELAY);
        CS_High();
    } while (status & 0x01);   // WIP = bit 0
}

/* ── Helper: WREN prima di ogni scrittura ───────────────────────── */
static void EEPROM_WriteEnable(void)
{
    uint8_t cmd = EEPROM_WREN;
    CS_Low();
    HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
    CS_High();
}

/* ══════════════════════════════════════════════════════════════════
 *  write_EEPROM
 *  Cancella tutta la EEPROM (scrive 0xFF), poi scrive la stringa
 *  a partire dall'indirizzo 0x0000.
 * ══════════════════════════════════════════════════════════════════ */
void write_EEPROM(char *str)
{
    uint16_t addr;
    uint8_t  buf[3 + EEPROM_PAGE_SIZE];
    uint8_t  page[EEPROM_PAGE_SIZE];

    /* ── 1. Cancella tutta la EEPROM scrivendo 0xFF pagina per pagina ── */
    memset(page, 0xFF, EEPROM_PAGE_SIZE);

    for (addr = 0; addr < EEPROM_TOTAL_SIZE; addr += EEPROM_PAGE_SIZE)
    {
        EEPROM_WriteEnable();

        buf[0] = EEPROM_WRITE;
        buf[1] = (addr >> 8) & 0xFF;   // indirizzo HIGH
        buf[2] =  addr       & 0xFF;   // indirizzo LOW
        memcpy(&buf[3], page, EEPROM_PAGE_SIZE);

        CS_Low();
        HAL_SPI_Transmit(&hspi1, buf, 3 + EEPROM_PAGE_SIZE, HAL_MAX_DELAY);
        CS_High();

        EEPROM_WaitReady();
    }

    /* ── 2. Scrivi la stringa (incluso '\0') pagina per pagina ───────── */
    uint16_t len       = (uint16_t)strlen(str) + 1;   // +1 per il terminatore
    uint16_t bytes_left = len;
    uint16_t src_offset = 0;

    addr = 0x0000;

    while (bytes_left > 0)
    {
        /* quanti byte possiamo scrivere in questa pagina? */
        uint16_t chunk = EEPROM_PAGE_SIZE;
        if (chunk > bytes_left) chunk = bytes_left;

        EEPROM_WriteEnable();

        buf[0] = EEPROM_WRITE;
        buf[1] = (addr >> 8) & 0xFF;
        buf[2] =  addr       & 0xFF;
        memcpy(&buf[3], str + src_offset, chunk);

        CS_Low();
        HAL_SPI_Transmit(&hspi1, buf, 3 + chunk, HAL_MAX_DELAY);
        CS_High();

        EEPROM_WaitReady();

        addr       += chunk;
        src_offset += chunk;
        bytes_left -= chunk;
    }
}

/* ══════════════════════════════════════════════════════════════════
 *  read_EEPROM
 *  Legge l'intera EEPROM e restituisce un puntatore a un buffer
 *  statico contenente la stringa terminata in '\0'.
 *  Il buffer è valido fino alla prossima chiamata della funzione.
 * ══════════════════════════════════════════════════════════════════ */
char *read_EEPROM(void)
{
    static char result[EEPROM_TOTAL_SIZE];

    uint8_t cmd[3];
    cmd[0] = EEPROM_READ;
    cmd[1] = 0x00;   // indirizzo HIGH
    cmd[2] = 0x00;   // indirizzo LOW

    CS_Low();
    HAL_SPI_Transmit(&hspi1, cmd, 3, HAL_MAX_DELAY);
    HAL_SPI_Receive (&hspi1, (uint8_t *)result, EEPROM_TOTAL_SIZE, HAL_MAX_DELAY);
    CS_High();

    /* Assicura la terminazione nel caso in cui non ci sia '\0' */
    result[EEPROM_TOTAL_SIZE - 1] = '\0';

    return result;
}


void setMotor(float percent, bool direction, bool on)
{
    // 1. Clamp del valore tra 0.0 e 1.0
    if (percent <= 0.0f) {
    	stopMotor();
    	return;
    }
    if (percent > 1.0f) percent = 1.0f;

    // 2. Gestione PIN ENABLE (PB0)
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, on ? GPIO_PIN_SET : GPIO_PIN_RESET);

    // 3. Gestione PIN DIRECTION (PB1)
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, direction ? GPIO_PIN_SET : GPIO_PIN_RESET);

    // 4. Mappatura PWM 10% → 90%
    float duty = 0.1f + 0.8f * percent;

    // CORREZIONE: Moltiplica per 99.0f (Counter Period), non per 999.0f
    uint32_t ccr = (uint32_t)(duty * 99.0f);

    // 5. Aggiornamento del registro del Timer
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, ccr);
}

void stopMotor(){
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_RESET);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
}

void parser(){
	if(sscanf(uart1_rx_buffer,"Mode %d",&stato) == 1){

		switch (stato) {
		case 0:

			break;
		case 1:
			break;
		case 2:
			break;
		case 3:
			sscanf(uart1_rx_buffer,"Mode 3 %f %d",&parametri_float[0],&parametri_int[0]);
			if (parametri_int[0] == 1){
				setMotor(1,true,true);
			}
			else{
				setMotor(parametri_float[0]/1000,false,true);
			}
			break;
		case 512: //EEPROM WRITE
			sscanf(uart1_rx_buffer,"Mode 512 %s",msg);
			write_EEPROM(msg);
			break;
		case 513: //EEPROM READ
			char* letto = read_EEPROM();
			HAL_UART_Transmit(&huart1, (uint8_t*)letto, strlen(letto), 200);
			break;
		case 514: //SDP_READLOOP
			SFM3300_Start();
			read_SDP810 = true;
			break;
		case 515: //SDP_WRITE_LOOP
			read_SDP810 = false;
			SFM3300_Stop();
			break;
		default:
			break;

		}
	}
}


void SDP810_Start() {
    uint8_t cmd[2] = {0x36, 0x15};
    HAL_StatusTypeDef ret = HAL_I2C_Master_Transmit(&hi2c1, SDP810_ADDR, cmd, 2, 100);
    if (ret != HAL_OK) {
        HAL_UART_Transmit(&huart1, (uint8_t*)"Start FAILED\r\n", 14, 100);
        return;
    }
    HAL_Delay(50); // wait for first conversion to be ready (~45ms)
    HAL_UART_Transmit(&huart1, (uint8_t*)"Misurazione AVVIATA\r\n", 21, 100);
}

// Invia il comando per fermare le misurazioni
void SDP810_Stop() {
    uint8_t cmd[2] = {0x3F, 0xF9};
    HAL_I2C_Master_Transmit(&hi2c1, SDP810_ADDR, cmd, 2, 100);
    HAL_UART_Transmit(&huart1, (uint8_t*)"Misurazione FERMATA\r\n", 21, 100);
}


void SDP810_Read(){
	uint8_t data[9];
	          char out_buf[64];
	          // Richiede 9 byte di risposta dal sensore
	          if (HAL_I2C_Master_Receive(&hi2c1, SDP810_ADDR, data, 9, 100) == HAL_OK) {

	              int16_t dp_raw = (data[0] << 8) | data[1];
	              int16_t scale_factor = (data[6] << 8) | data[7];

	              if (scale_factor != 0) {
	                  float pressure = (float)dp_raw / (float)scale_factor;

	                  // Formatta la stringa (richiede l'abilitazione dei float nelle impostazioni STM32)


	                	  sprintf(out_buf, "SNSR %.2f 0 0\r\n", pressure);
	                  // Trasmetti su entrambe le porte
	                    HAL_UART_Transmit(&huart1, (uint8_t*)out_buf, strlen(out_buf), 100);



	              }
	          } else {
	              HAL_UART_Transmit(&huart1, (uint8_t*)"Errore Lettura\r\n", 16, 100);
	          }
}


/* ── CRC-8 check (poly 0x31) ────────────────────────────────────── */
static uint8_t SFM3300_CRC(uint8_t msb, uint8_t lsb)
{
    uint8_t crc = 0x00;
    uint8_t data[2] = {msb, lsb};
    for (int i = 0; i < 2; i++) {
        crc ^= data[i];
        for (int b = 0; b < 8; b++)
            crc = (crc & 0x80) ? (crc << 1) ^ 0x31 : (crc << 1);
    }
    return crc;
}

void SFM3300_Start(void)
{
    uint8_t cmd[2] = {0x10, 0x00};
    HAL_StatusTypeDef ret = HAL_I2C_Master_Transmit(&hi2c1, SFM3300_ADDR, cmd, 2, 100);
    if (ret != HAL_OK) {
        HAL_UART_Transmit(&huart1, (uint8_t*)"SFM3300 Start FAILED\r\n", 22, 100);
        return;
    }
    // Datasheet: wait 100ms after start before first valid read
    HAL_Delay(100);
    HAL_UART_Transmit(&huart1, (uint8_t*)"SFM3300 AVVIATO\r\n", 17, 100);
}

void SFM3300_Stop(void)
{
    // Sending any command other than 0x1000 stops measurement.
    // Soft reset (0x2000) is the cleanest way.
    uint8_t cmd[2] = {0x20, 0x00};
    HAL_I2C_Master_Transmit(&hi2c1, SFM3300_ADDR, cmd, 2, 100);
    HAL_UART_Transmit(&huart1, (uint8_t*)"SFM3300 FERMATO\r\n", 17, 100);
}

void SFM3300_Read(void)
{
    // Datasheet recommends re-sending 0x1000 before every read
    // to guard against unnoticed sensor resets
    uint8_t cmd[2] = {0x10, 0x00};
    if (HAL_I2C_Master_Transmit(&hi2c1, SFM3300_ADDR, cmd, 2, 100) != HAL_OK) {
        HAL_UART_Transmit(&huart1, (uint8_t*)"SFM3300 Cmd FAILED\r\n", 20, 100);
        return;
    }

    // Read 3 bytes: 2 data + 1 CRC
    uint8_t data[3];
    if (HAL_I2C_Master_Receive(&hi2c1, SFM3300_ADDR, data, 3, 100) != HAL_OK) {
        HAL_UART_Transmit(&huart1, (uint8_t*)"SFM3300 Read FAILED\r\n", 21, 100);
        return;
    }

    // Verify CRC
    if (SFM3300_CRC(data[0], data[1]) != data[2]) {
        HAL_UART_Transmit(&huart1, (uint8_t*)"SFM3300 CRC ERR\r\n", 17, 100);
        return;
    }

    // Convert raw value to slm
    int16_t raw = (int16_t)((data[0] << 8) | data[1]);
    float flow = ((float)raw - SFM3300_OFFSET) / SFM3300_SCALE;

    char out[64];
    sprintf(out, "SNSR %.2f 0 0\r\n", flow);
    HAL_UART_Transmit(&huart1, (uint8_t*)out, strlen(out), 100);
}


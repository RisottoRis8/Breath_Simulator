/* USER CODE BEGIN 4 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
	//HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_SET);
  if (huart->Instance == USART1)
  {
    // Se la stringa precedente non è ancora stata elaborata nel main, scartiamo i nuovi dati per sicurezza
    if (!uart1_str_ready)
    {
      // Controllo delimitatori di fine riga (\n o \r)
      if (uart1_tmp_byte == '\n' || uart1_tmp_byte == '\r')
      {
        // Taglia la stringa solo se contiene effettivamente qualcosa
        if (uart1_idx > 0)
        {
          uart1_rx_buffer[uart1_idx] = '\0'; // Chiude la stringa in modo sicuro
          uart1_str_ready = true;            // Sveglia il controllo nel main loop
        }
      }
      else
      {
        // Accumula il carattere nel buffer evitando l'overflow
        if (uart1_idx < (BUFFER_SIZE - 1))
        {
          uart1_rx_buffer[uart1_idx++] = (char)uart1_tmp_byte;
        }
      }
    }
    // Riarma istantaneamente l'interrupt per il byte successivo
    HAL_UART_Receive_IT(&huart1, &uart1_tmp_byte, 1);
  }
  else if (huart->Instance == USART2)
  {
    // Se la stringa precedente non è ancora stata elaborata nel main, scartiamo i nuovi dati
    if (!uart2_str_ready)
    {
      // Controllo delimitatori di fine riga (\n o \r)
      if (uart2_tmp_byte == '\n' || uart2_tmp_byte == '\r')
      {
        if (uart2_idx > 0)
        {
          uart2_rx_buffer[uart2_idx] = '\0'; // Chiude la stringa
          uart2_str_ready = true;            // Sveglia il controllo nel main loop
        }
      }
      else
      {
        // Accumula il carattere nel buffer evitando l'overflow
        if (uart2_idx < (BUFFER_SIZE - 1))
        {
          uart2_rx_buffer[uart2_idx++] = (char)uart2_tmp_byte;
        }
      }
    }
    // Riarma istantaneamente l'interrupt per il byte successivo
    HAL_UART_Receive_IT(&huart2, &uart2_tmp_byte, 1);
  }
  //HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3, GPIO_PIN_RESET);
}

/**
  * @brief Gestione degli errori hardware della UART (Overrun, Noise, Frame Error)
  */
void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART1)
  {
    HAL_UART_Receive_IT(&huart1, &uart1_tmp_byte, 1);
  }
  else if (huart->Instance == USART2)
  {
    HAL_UART_Receive_IT(&huart2, &uart2_tmp_byte, 1);
  }
}





//INTERRUPT TIMER 7 TEMPORIZZATORE
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM7)
    {
    	temporizzatore = true;
    	divisore++;
    	if (divisore==10) { //100Hz
    		temporizzatore_PID = true;
    		divisore = 0;
    	}
    	HAL_TIM_Base_Start_IT(&htim7);
        // codice eseguito ogni 1 ms
    }
}
//INTERRUPT MICROSWITCH
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    // Controlliamo se l'interrupt è stato generato dal pin 3 (PB3) o dal pin 8 (PA8)
    if(GPIO_Pin == GPIO_PIN_6 || GPIO_Pin == GPIO_PIN_7)
    {
        // Ferma immediatamente il motore
        stopMotor();

        // Opzionale: invia un messaggio di notifica (usiamo un timeout bassissimo
        // per non bloccare troppo a lungo l'esecuzione dentro l'interrupt)
        char msg_stop[] = "EMERGENZA: Microswitch premuto. Motore fermato!\r\n";
        HAL_UART_Transmit(&huart1, (uint8_t*)msg_stop, strlen(msg_stop), 10);
    }
}




